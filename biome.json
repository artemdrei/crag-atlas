{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/src/generated",
      "!pnpm-lock.yaml",
      "!**/*.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useHtmlLang": "warn",
        "noSvgWithoutTitle": "warn"
      },
      "suspicious": {
        "noConsole": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react-*", "react/**", "react-*/**"],
              ":BLANK_LINE:",
              [":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@web/**"],
              ":BLANK_LINE:",
              ["@web/**"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@mui/*/*/*"],
                    "message": "Avoid deep @mui imports."
                  },
                  {
                    "group": ["../../../*", "../../../**"],
                    "message": "Avoid deep relative imports (3+ levels up). Use @web/* instead."
                  },
                  {
                    "group": ["@web/features/*/**"],
                    "message": "Features communicate only through their root barrel: @web/features/<name>."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shared/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@mui/*/*/*"],
                    "message": "Avoid deep @mui imports."
                  },
                  {
                    "group": ["../../../*", "../../../**"],
                    "message": "Avoid deep relative imports (3+ levels up). Use @web/* instead."
                  },
                  {
                    "group": [
                      "@web/app",
                      "@web/app/*",
                      "@web/pages/*",
                      "@web/widgets/*",
                      "@web/features/*"
                    ],
                    "message": "shared/ must not depend on app/pages/widgets/features layers."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
