# Defaults match the local stack `supabase start` prints; override only when
# the CLI is configured to use other ports.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase status`>

# Ports of the servers the suite starts for itself. They are not 4000/4001 on
# purpose: those are the developer's own dev servers, pointed at a hosted
# project, and this suite erases catalog rows for good.
WEB_URL=http://localhost:4100
API_URL=http://localhost:4101
