  "info": {
    "title": "crag-atlas API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "idUser": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Mirrors the user_roles row the RLS checks"
          },
          "gradeScaleRoute": {
            "type": "string",
            "enum": [
              "french",
              "yds",
              "uiaa",
              "saxon",
              "ewbank",
              "norwegian",
              "brazilian_crux"
            ],
            "description": "System every route grade is shown in"
          },
          "gradeScaleBoulder": {
            "type": "string",
            "enum": ["font", "vscale"],
            "description": "Boulder grades never convert into route grades, so they pick their own"
          }
        },
        "required": [
          "idUser",
          "isAdmin",
          "gradeScaleRoute",
          "gradeScaleBoulder"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "gradeScaleRoute": {
            "type": "string",
            "enum": [
              "french",
              "yds",
              "uiaa",
              "saxon",
              "ewbank",
              "norwegian",
              "brazilian_crux"
            ]
          },
          "gradeScaleBoulder": {
            "type": "string",
            "enum": ["font", "vscale"]
          }
        }
      },
      "RegionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "rockType": {
            "type": "string"
