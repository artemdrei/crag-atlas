  "info": {
    "title": "crag-atlas API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "rockType": {
            "type": "string"
          },
          "sectorCount": {
            "type": "number"
          },
          "routeCount": {
            "type": "number"
          },
          "gradeRange": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "province",
          "rockType",
          "sectorCount",
          "routeCount",
          "gradeRange"
        ]
      },
      "SectorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idRegion": {
            "type": "string"
          },
          "regionName": {
            "type": "string",
            "description": "Label for breadcrumbs; ids carry no meaning"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "approachMinutes": {
            "type": "number",
            "nullable": true
          },
          "routeCount": {
            "type": "number"
          },
          "gradeRange": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "idRegion",
          "regionName",
          "name",
          "description",
          "routeCount",
          "gradeRange"
        ]
      },
      "RouteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idSector": {
            "type": "string"
          },
          "sectorName": {
            "type": "string",
            "description": "Label for breadcrumbs; ids carry no meaning"
          },
          "idRegion": {
            "type": "string"
          },
          "regionName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["sport", "trad", "boulder"]
          },
          "length": {
            "type": "number",
            "nullable": true
          },
          "boltsCount": {
            "type": "number",
            "nullable": true
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "idSector",
          "sectorName",
          "idRegion",
          "regionName",
          "name",
          "grade",
          "type",
          "description"
        ]
      },
      "TickDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idUser": {
            "type": "string"
          },
          "idRoute": {
            "type": "string"
          },
          "routeName": {
            "type": "string",
            "nullable": true,
            "description": "Resolved from the route catalog; null if the route is gone"
          },
          "routeGrade": {
            "type": "string",
            "nullable": true
          },
          "sectorName": {
            "type": "string",
            "nullable": true
          },
          "ascentStyle": {
            "type": "string",
            "enum": [
              "onsight",
              "flash",
              "retro_flash",
              "redpoint",
              "toprope",
              "attempt"
            ]
          },
          "climbedAt": {
            "type": "string",
            "description": "ISO date, e.g. 2026-09-19"
          },
          "attempts": {
            "type": "number",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "idUser",
          "idRoute",
          "ascentStyle",
          "climbedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTickDto": {
        "type": "object",
        "properties": {
          "idRoute": {
            "type": "string"
          },
          "ascentStyle": {
            "type": "string",
            "enum": [
              "onsight",
              "flash",
              "retro_flash",
              "redpoint",
              "toprope",
              "attempt"
            ]
          },
          "climbedAt": {
            "type": "string",
            "description": "ISO date; defaults to today"
          },
          "attempts": {
            "type": "number",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["idRoute", "ascentStyle"]
      }
    }
  }
}
