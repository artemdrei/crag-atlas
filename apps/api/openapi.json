  "info": {
    "title": "crag-atlas API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "idUser": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Mirrors the user_roles row the RLS checks"
          }
        },
        "required": ["idUser", "isAdmin"]
      },
      "RegionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "rockType": {
            "type": "string"
          },
          "sectorCount": {
            "type": "number"
          },
          "routeCount": {
            "type": "number"
          },
          "gradeRange": {
            "type": "string",
            "nullable": true,
            "description": "Derived from the routes of the region; null when it has none"
          }
        },
        "required": [
          "id",
          "name",
          "province",
          "rockType",
          "sectorCount",
          "routeCount"
        ]
      },
      "UpdateRegionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "rockType": {
            "type": "string"
          }
        },
        "required": ["name", "province", "rockType"]
      },
      "SectorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idRegion": {
            "type": "string"
          },
          "regionName": {
            "type": "string",
            "description": "Label for breadcrumbs; ids carry no meaning"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string",
            "nullable": true,
            "description": "First topo photo, used as the card thumbnail"
          },
          "description": {
            "type": "string"
          },
          "routeCount": {
            "type": "number"
          },
          "gradeRange": {
            "type": "string",
            "nullable": true,
            "description": "Derived from the routes of the sector; null when it has none"
          }
        },
        "required": [
          "id",
          "idRegion",
          "regionName",
          "name",
          "description",
          "routeCount"
        ]
      },
      "UpdateSectorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["name"]
      },
      "RouteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idSector": {
            "type": "string"
          },
          "sectorName": {
            "type": "string",
            "description": "Label for breadcrumbs; ids carry no meaning"
          },
          "idRegion": {
            "type": "string"
          },
          "regionName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["sport", "trad", "boulder"]
          },
          "length": {
            "type": "number",
            "nullable": true
          },
          "boltsCount": {
            "type": "number",
            "nullable": true
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "description": "Community rating, 0..5"
          },
          "ascentsCount": {
            "type": "number",
            "nullable": true
          },
          "onsightCount": {
            "type": "number",
            "nullable": true
          },
          "votesSoft": {
            "type": "number",
            "nullable": true,
            "description": "Votes saying the grade is soft"
          },
          "votesNeutral": {
            "type": "number",
            "nullable": true
          },
          "votesHard": {
            "type": "number",
            "nullable": true
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "idSector",
          "sectorName",
          "idRegion",
          "regionName",
          "name",
          "grade",
          "type",
          "description"
        ]
      },
      "UpdateRouteDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["sport", "trad", "boulder"]
          },
          "length": {
            "type": "number",
            "nullable": true
          },
          "boltsCount": {
            "type": "number",
            "nullable": true
          },
          "rating": {
            "type": "number",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["name", "grade", "type"]
      },
      "TickDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idUser": {
            "type": "string"
          },
          "idRoute": {
            "type": "string"
          },
          "routeName": {
            "type": "string",
            "nullable": true,
            "description": "Resolved from the route catalog; null if the route is gone"
          },
          "routeGrade": {
            "type": "string",
            "nullable": true
          },
          "sectorName": {
            "type": "string",
            "nullable": true
          },
          "ascentStyle": {
            "type": "string",
            "enum": [
              "onsight",
              "flash",
              "retro_flash",
              "redpoint",
              "toprope",
              "attempt"
            ]
          },
          "climbedAt": {
            "type": "string",
            "description": "ISO date, e.g. 2026-09-19"
          },
          "attempts": {
            "type": "number",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "idUser",
          "idRoute",
          "ascentStyle",
          "climbedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTickDto": {
        "type": "object",
        "properties": {
          "idRoute": {
            "type": "string"
          },
          "ascentStyle": {
            "type": "string",
            "enum": [
              "onsight",
              "flash",
              "retro_flash",
              "redpoint",
              "toprope",
              "attempt"
            ]
          },
          "climbedAt": {
            "type": "string",
            "description": "ISO date; defaults to today"
          },
          "attempts": {
            "type": "number",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["idRoute", "ascentStyle"]
      },
      "RouteLineDto": {
        "type": "object",
        "properties": {
          "idRoute": {
            "type": "string"
          },
          "routeName": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "description": "[[x, y], …] as 0..1 fractions of the photo"
          }
        },
        "required": ["idRoute", "routeName", "grade", "points"]
      },
      "TopoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteLineDto"
            }
          }
        },
        "required": ["id", "label", "photoUrl", "lines"]
      },
      "CommentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idRoute": {
            "type": "string"
          },
          "idUser": {
            "type": "string"
          },
          "authorName": {
            "type": "string",
            "description": "Author label; ids carry no meaning"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp"
          }
        },
        "required": [
          "id",
          "idRoute",
          "idUser",
          "authorName",
          "body",
          "createdAt"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          }
        },
        "required": ["body"]
      },
      "MediaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "idRoute": {
            "type": "string"
          },
          "idUser": {
            "type": "string"
          },
          "authorName": {
            "type": "string",
            "description": "Author label; ids carry no meaning"
          },
          "kind": {
            "type": "string",
            "enum": ["video", "photo"]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp"
          }
        },
        "required": [
          "id",
          "idRoute",
          "idUser",
          "authorName",
          "kind",
          "url",
          "title",
          "createdAt"
        ]
      },
      "CreateMediaDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["video", "photo"]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          }
        },
        "required": ["kind", "url"]
      }
    }
  }
}
