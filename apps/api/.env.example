# Supabase — Project Settings → API. The API talks to the database with the
# caller's own token, so only the publishable (anon) key belongs here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Only the skyline builder uses it, and only outside a request: building a
# sector's horizon profile happens long after the save that queued it, with
# no caller to borrow a token from. It bypasses row level security — keep it
# out of anything a browser can reach.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Origins the browser may call this API from, comma separated. Unset allows
# any origin, which is what local development wants.
WEB_ORIGIN=
