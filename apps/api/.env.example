# Supabase — Project Settings → API. The API talks to the database with the
# caller's own token, so only the publishable (anon) key belongs here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Origins the browser may call this API from, comma separated. Unset allows
# any origin, which is what local development wants.
WEB_ORIGIN=
