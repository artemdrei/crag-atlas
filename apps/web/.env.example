# Backend (apps/api) base URL
VITE_API_URL=http://localhost:4001

# Supabase — Project Settings → API. Auth only, never used for data queries.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Amplitude — Settings → Projects → API Key. Unset disables analytics. Use a
# dev project's key locally so clicks never reach the production one.
VITE_AMPLITUDE_API_KEY=
