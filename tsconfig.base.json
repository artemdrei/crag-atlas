{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@crag-atlas/api": ["./packages/api/src/index.ts"],
      "@crag-atlas/utils": ["./packages/utils/src/index.ts"],
      "@web/*": ["./apps/web/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
